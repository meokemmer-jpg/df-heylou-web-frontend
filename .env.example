# df-heylou-web-frontend Environment Variables
# CRUX-MK: K13 Pre-Action-Verification — env-tag muss verifiziert sein vor Production-Deploy

# === Sandbox-Default (Welle-38 Welle-Default) ===
HEYLOU_WEB_SANDBOX=true

# === Database (Postgres via Supabase) ===
DATABASE_URL=postgresql://user:pass@host:5432/heylou_web
# Pflicht fuer Production. Sandbox: leer → In-Memory-DB.

# === Auth (Clerk) ===
CLERK_SECRET_KEY=sk_test_REDACTED
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REDACTED
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_WEBHOOK_SECRET=whsec_REDACTED
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REDACTED

# === HeyLou-Travel-Domain Connector (df-heylou-travel-domain) ===
HEYLOU_API_URL=https://api.heylou.example/v1
HEYLOU_API_SERVICE_TOKEN=svc_REDACTED

# === 9OS-NEXT Coupling ===
9OS_NEXT_URL=https://9os.example/api/v1
9OS_NEXT_SERVICE_TOKEN=svc_REDACTED

# === Audit-Log HMAC-Key (W30-G) ===
AUDIT_LOG_HMAC_KEY=REDACTED_GENERATE_VIA_OPENSSL_RAND_HEX_32

# === Phronesis-Ticket fuer Production-Aktivierung ===
PHRONESIS_TICKET=PT-WELLE-39-PENDING
# Pflicht: muss von Martin-Phronesis-approval signiert sein vor Production.
